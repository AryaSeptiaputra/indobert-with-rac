# Salin ke .env lalu sesuaikan. File .env TIDAK di-commit.

# --- Path (relatif terhadap root repositori) ---
DATA_DIR=data
OUTPUT_DIR=outputs
MODEL_DIR=models
DEFAULT_OUT_DIR=outputs/tuning

# --- Model dasar ---
BASE_MODEL=indobenchmark/indobert-base-p2
MAX_LENGTH=128
NUM_LABELS=2

# --- Training ---
RANDOM_SEED=42
# Batas VRAM per langkah maju/mundur. Batch efektif tetap ditentukan config run;
# gradient accumulation menutup selisihnya. Turunkan bila OOM.
MICRO_BATCH=8
FEATURE_BATCH_SIZE=32
NUM_WORKERS=0

# --- Pengukuran efisiensi (harus sama untuk RM-a/b/c agar sebanding) ---
LATENCY_WARMUP_RUNS=10
LATENCY_RUNS=100

# --- Aturan seleksi hyperparameter ---
# Selisih F1-macro (poin persentase) yang masih dianggap seri.
TIE_THRESHOLD_PP=0.15

# --- Logging: text (pengembangan) atau json (produksi) ---
LOG_FORMAT=text
