# ---------------------------------------------------------------------------
# Artefak Python
# ---------------------------------------------------------------------------
__pycache__/
*.py[cod]
build/
dist/
*.egg-info/
.pytest_cache/
.coverage
htmlcov/

# ---------------------------------------------------------------------------
# Virtual environment
# ---------------------------------------------------------------------------
.venv/
venv/
env/

# ---------------------------------------------------------------------------
# Jupyter
# ---------------------------------------------------------------------------
.ipynb_checkpoints/

# ---------------------------------------------------------------------------
# Data
# Dataset komentar YouTube memuat kolom identitas (author, authorChannelId).
# Lihat DATASET.md untuk keputusan distribusinya.
# ---------------------------------------------------------------------------
data/raw/*
data/interim/*
data/processed/*
!data/**/.gitkeep

# Dataset skripsi SENGAJA ikut di-commit demi reproduktibilitas: penguji harus
# bisa menjalankan ulang seluruh pipeline dari repo ini. Keputusan sadar, bukan
# kelalaian. Berkas data lain di luar daftar ini tetap terblokir oleh pola di
# atas.
!data/raw/data_labeling.csv
!data/interim/data_clean.csv
!data/processed/train.csv
!data/processed/val.csv
!data/processed/test.csv
!data/processed/metadata.json

# ---------------------------------------------------------------------------
# Keluaran eksperimen
# Hasil run TIDAK disimpan di git. Berkas seperti runs_*.csv, best.json, dan
# history/ dibaca ulang oleh CampaignRunner: run_batch melewati konfigurasi yang
# sudah tercatat (resume) dan BestTracker hanya mempromosikan F1 yang lebih tinggi
# dari juara tercatat. Hasil lama yang ikut ter-clone membuat kampanye baru di
# instance lain berjalan tanpa menghasilkan apa pun dan tanpa checkpoint juara.
# Simpan hasil dari mesin tempat kampanye berjalan (mis. HASIL.xlsx), bukan lewat git.
#
# Yang tetap ter-track: figur EDA (keluaran 01_eda, bukan hasil kampanye) dan README.
# ---------------------------------------------------------------------------
outputs/**
!outputs/**/
!outputs/_migration_checksums.json
!outputs/**/README.md
!outputs/figures/eda/*.png

# ---------------------------------------------------------------------------
# Bobot model
# ---------------------------------------------------------------------------
models/*
!models/.gitkeep
*.bin
*.safetensors
*.faiss
*.index

# ---------------------------------------------------------------------------
# Berkas turunan yang bisa diregenerasi
# ---------------------------------------------------------------------------
HASIL*.xlsx
*.zip
hasil_*.tar.gz

