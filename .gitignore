# ---------------------------------------------------------------------------
# Artefak Python
# ---------------------------------------------------------------------------
__pycache__/
*.py[cod]
build/
dist/
*.egg-info/
.pytest_cache/
.coverage
htmlcov/

# ---------------------------------------------------------------------------
# Virtual environment
# ---------------------------------------------------------------------------
.venv/
venv/
env/

# ---------------------------------------------------------------------------
# Jupyter
# ---------------------------------------------------------------------------
.ipynb_checkpoints/

# ---------------------------------------------------------------------------
# Data
# Dataset komentar YouTube memuat kolom identitas (author, authorChannelId).
# Lihat DATASET.md untuk keputusan distribusinya.
# ---------------------------------------------------------------------------
data/raw/*
data/interim/*
data/processed/*
!data/**/.gitkeep

# ---------------------------------------------------------------------------
# Keluaran eksperimen
# Seluruh isi outputs/ bisa dihasilkan ulang oleh notebook, KECUALI berkas
# ringkas yang dikutip langsung di Bab 4 -- itu di-whitelist di bawah.
# ---------------------------------------------------------------------------
outputs/*
!outputs/*/

# Arsip kampanye Vast.ai: disimpan di disk sebagai jalan mundur sampai kampanye
# lokal terbukti berhasil, lalu dihapus. Tidak pernah masuk git (folder aslinya
# results/vast/ juga tidak).
outputs/_archive_*/

outputs/**/features/
outputs/**/checkpoints/
outputs/**/*.npy
outputs/**/*.pt
outputs/**/job.log
outputs/**/job.pid

!outputs/_migration_checksums.json
!outputs/**/runs_*.csv
!outputs/**/best.json
!outputs/**/hardware.json
!outputs/**/tuning_summary.json
!outputs/**/metrics/*.csv
!outputs/**/history/*.csv
!outputs/**/README.md
!outputs/figures/eda/*.png

# ---------------------------------------------------------------------------
# Bobot model
# ---------------------------------------------------------------------------
models/*
!models/.gitkeep
*.bin
*.safetensors
*.faiss
*.index

# ---------------------------------------------------------------------------
# Berkas turunan yang bisa diregenerasi
# ---------------------------------------------------------------------------
HASIL.xlsx
*.zip

# ---------------------------------------------------------------------------
# Rahasia
# ---------------------------------------------------------------------------
.env
*.pem

# ---------------------------------------------------------------------------
# OS dan editor
# ---------------------------------------------------------------------------
.DS_Store
.vscode/
.idea/

